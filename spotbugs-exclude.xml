<FindBugsFilter>
    <!-- jOOQ generates this package from ddl-postgresql.sql. -->
    <Match>
        <Package name="io.sailkit.billing.plugin.liqpay.dao.gen" />
    </Match>
    <Match>
        <Package name="io.sailkit.billing.plugin.liqpay.dao.gen.tables" />
    </Match>
    <Match>
        <Package name="io.sailkit.billing.plugin.liqpay.dao.gen.tables.records" />
    </Match>
    <!-- The API and the servlet keep the injected store. It is a collaborator, not internal state. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Or>
            <Class name="io.sailkit.billing.plugin.liqpay.api.LiqPayPaymentPluginApi" />
            <Class name="io.sailkit.billing.plugin.liqpay.servlet.LiqPayCallbackServlet" />
        </Or>
        <Field name="store" />
    </Match>
    <!-- Kill Bill never serializes the servlet. The HTTP client cache is built again with each servlet. -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED" />
        <Class name="io.sailkit.billing.plugin.liqpay.servlet.LiqPayCallbackServlet" />
        <Field name="clients" />
    </Match>
</FindBugsFilter>
