<!-- Run with: mvn -Pjooq-codegen generate-sources. The output is checked in. -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.15.0.xsd">
    <generator>
        <database>
            <name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
            <properties>
                <property>
                    <key>scripts</key>
                    <value>src/main/resources/ddl-postgresql.sql</value>
                </property>
                <property>
                    <key>sort</key>
                    <value>semantic</value>
                </property>
                <property>
                    <key>defaultNameCase</key>
                    <value>lower</value>
                </property>
                <property>
                    <key>unqualifiedSchema</key>
                    <value>none</value>
                </property>
            </properties>
            <includes>liqpay_.*</includes>
            <outputSchemaToDefault>true</outputSchemaToDefault>
        </database>
        <generate>
            <javaTimeTypes>true</javaTimeTypes>
            <generatedAnnotation>false</generatedAnnotation>
        </generate>
        <target>
            <packageName>io.sailkit.billing.plugin.liqpay.dao.gen</packageName>
            <directory>src/main/java</directory>
        </target>
    </generator>
</configuration>
